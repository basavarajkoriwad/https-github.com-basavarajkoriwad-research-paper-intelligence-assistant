# Runtime Environment: development | production
SCHOLARMIND_ENV=development

# Hardware profile: cpu_lite | production | gpu_consumer | gpu_research
SCHOLARMIND_PROFILE=cpu_lite

# Backend API Server
SCHOLARMIND_HOST=0.0.0.0
SCHOLARMIND_PORT=8000

# Comma-separated CORS origins (* in development; explicit UI origin in production)
SCHOLARMIND_CORS_ORIGINS=*

# Streamlit Frontend -> FastAPI Backend URL (set to http://api:8000 in Docker, ACA FQDN in Azure)
SCHOLARMIND_API_URL=http://127.0.0.1:8000

# Open-Source LLM Provider: local (google/flan-t5-base in PyTorch) | ollama (requires Ollama daemon)
SCHOLARMIND_LLM_PROVIDER=local

# Persistent storage & Hugging Face model cache directories
SCHOLARMIND_DATA_DIR=data
SCHOLARMIND_ARTIFACTS_DIR=artifacts
HF_HOME=artifacts/hf_cache

# Optional: Manual Kaggle ArXiv JSONL file path
# Download from: https://www.kaggle.com/datasets/Cornell-University/arxiv
ARXIV_KAGGLE_JSON_PATH=data/raw/arxiv/arxiv-metadata-oai-snapshot.json

# Optional: Hugging Face token (only needed for higher Hub rate limits or gated models)
HF_TOKEN=
